# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Crawl + API output. All of it is regenerable by re-running scripts/, and it
# churns on every run — ~5.5MB of diff noise per refresh.
/data/*.json

# ...EXCEPT the files a human wrote, which no script can reproduce.
# (gitignore has no inline comments — a trailing "# note" becomes part of the
# pattern and silently ignores the file you meant to keep.)
# breweries.json: hand-curated source that build-registry.mjs reads
# breweries.seed.json: the original 63
# ground-truth.json: Corey's held-out answers, the only test set we have
# corrections.json: human judgements that must survive a rebuild
!/data/breweries.json
!/data/breweries.seed.json
!/data/ground-truth.json
!/data/corrections.json

# registry.json is DERIVED but must be tracked anyway: lib/data.ts imports it,
# so the Next build fails without it and a fresh clone cannot run the app.
# Regenerate with scripts/build-registry.mjs; commit the result.
!/data/registry.json
# Same reason — lib/data.ts joins releases onto the registry at import time.
!/data/releases.json

# wide-harvest raw corpus — other people's pages, never committed to the public repo
/data/harvest/

# ...but the DERIVED claims (short verified quotes + provenance) and the pilot
# roster are human-reviewable evidence, not crawler churn. Track them.
!/data/pilot-set.json
!/data/claims/
